#!/usr/bin/env bash
# backtest-auditor pre-commit hook
# Target: < 30 seconds
# Coverage and thorough tests run in CI only.
#
# Install: git config core.hooksPath .githooks
# Or run:  scripts/setup-dev.sh

set -euo pipefail

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

pass() { echo -e "${GREEN}  ✓${NC} $1"; }
fail() { echo -e "${RED}  ✗${NC} $1"; exit 1; }
warn() { echo -e "${YELLOW}  !${NC} $1"; }

echo "backtest-auditor pre-commit"
echo "───────────────────────────"

# ── Stage 1: Format (~2s) ────────────────────────────────────────────────────
printf "[1/4] format  "
if uv run ruff format --check . >/dev/null 2>&1; then
    pass "ok"
else
    echo ""
    uv run ruff format --check . 2>&1 | head -20
    fail "formatting errors — run: uv run ruff format ."
fi

# ── Stage 2: Lint (~3s) ──────────────────────────────────────────────────────
printf "[2/4] lint    "
if uv run ruff check . >/dev/null 2>&1; then
    pass "ok"
else
    echo ""
    uv run ruff check . 2>&1 | head -20
    fail "lint errors — run: uv run ruff check . --fix"
fi

# ── Stage 3: Type check (~5s) ────────────────────────────────────────────────
printf "[3/4] mypy    "
if uv run mypy src >/dev/null 2>&1; then
    pass "ok"
else
    echo ""
    uv run mypy src 2>&1 | tail -20
    fail "type errors — run: uv run mypy src"
fi

# ── Stage 4: Tests (~15s) ────────────────────────────────────────────────────
printf "[4/4] pytest  "
uv run pytest -q >/dev/null 2>&1 || code=$?
code=${code:-0}
if [ $code -eq 0 ] || [ $code -eq 5 ]; then
    # exit 5 = no tests collected — acceptable during early development
    pass "ok"
else
    echo ""
    uv run pytest -q 2>&1 | tail -20
    fail "tests failed — run: uv run pytest"
fi

echo "───────────────────────────"
echo -e "${GREEN}pre-commit passed${NC}"
